# ============================================
# PinAutoFlow — Environment Configuration
# ============================================

# --- GOOGLE GEMINI AI ---
# Get free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- PINTEREST ---
# Get free: https://developers.pinterest.com
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_BOARD_ID=your_pinterest_board_id_here

# --- AMAZON AFFILIATE TAGS (Global) ---
# Sign up FREE at each: https://affiliate-program.amazon.com
# Each country = separate Associates account
AMAZON_TAG_US=your-tag-20          # amazon.com (biggest - do this first)
AMAZON_TAG_UK=your-tag-21          # amazon.co.uk
AMAZON_TAG_CA=your-tag-22          # amazon.ca
AMAZON_TAG_AU=your-tag-23          # amazon.com.au
AMAZON_TAG_DE=your-tag-24          # amazon.de (Germany - high commissions)
AMAZON_TAG_FR=your-tag-25          # amazon.fr
AMAZON_TAG_IN=your-tag-26          # amazon.in
AMAZON_TAG_AE=your-tag-27          # amazon.ae (UAE - growing fast)
AMAZON_TAG_SA=your-tag-28          # amazon.sa

# --- DARAZ AFFILIATE (Pakistan) ---
# Get at: https://affiliate.daraz.pk
DARAZ_TAG=your_daraz_affiliate_tag

# --- GENIUS LINKS (Optional - one link routes all countries) ---
# Free at: https://geni.us — simpler alternative to managing multiple tags
GENIUS_LINKS_ID=your_genius_links_id

# --- SERVER ---
PORT=3001
BASE_URL=http://localhost:3001

# --- RESEARCH SETTINGS ---
RESEARCH_INTERVAL_HOURS=6
MAX_PRODUCTS_TO_SHORTLIST=6
MIN_TREND_SCORE=60

# --- POSTING SETTINGS ---
POSTS_PER_DAY=3
POST_TIMES=09:00,14:00,19:00
